# Copy to .dev.vars (never commit it). Values come from JAL's IT team (cPanel email account).

# Mailbox address(es) allowed to sign in to the app, comma-separated. Reminders are sent from the
# signed-in account. Passwords are typed on the sign-in page and never stored in this file.
EMAIL_ALLOWED_ACCOUNTS=

# At least 32 random characters. Encrypts signed-in mailbox passwords on the server.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Outgoing (SMTP) server. Port 465 uses SSL, 587 uses STARTTLS. Port 25 is not allowed.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
# Optional: ssl or starttls. Worked out from the port when left blank.
EMAIL_SMTP_SECURITY=

# Incoming (IMAP) server, used only to save a copy of each sent email in the Sent folder.
# Leave EMAIL_IMAP_HOST blank to skip saving copies (use EMAIL_BCC instead when Outlook uses POP).
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
# Optional: ssl or starttls. Worked out from the port when left blank.
EMAIL_IMAP_SECURITY=
# Optional: the exact Sent folder name, if it is not found automatically (cPanel usually uses INBOX.Sent).
EMAIL_SENT_FOLDER=

# Hidden copy (BCC) of every live email, so the team sees it in Outlook whether Outlook uses POP or IMAP.
# Test sends skip it. Separate several addresses with commas.
EMAIL_BCC=

# How the sender appears to customers, and an optional different reply address.
EMAIL_FROM_NAME=JAL Accounts Receivable
EMAIL_REPLY_TO=

# The hosting company's hourly sending limit. The app stays at or below it.
EMAIL_HOURLY_LIMIT=100

# "test" (default) sends every email to EMAIL_TEST_RECIPIENT instead of the customer.
# Set to "live" only when you are ready to email real customers.
EMAIL_MODE=test
EMAIL_TEST_RECIPIENT=

# OneDrive shared tracker. Values from the Microsoft app registration (see docs/ONEDRIVE_SETUP.md).
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# "consumers" for a personal Microsoft account. Later, JAL's tenant ID for a work account.
ONEDRIVE_TENANT=consumers
# Only for the practice OneDrive on this computer (npm run onedrive:practice); accepted for localhost only.
# ONEDRIVE_LOGIN_URL=http://127.0.0.1:8787
# ONEDRIVE_GRAPH_URL=http://127.0.0.1:8787/v1.0
